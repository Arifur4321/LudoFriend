<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- INTERNET for the Flutter tool (hot reload, debugger). -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- DEBUG ONLY: allow plain-text HTTP so the app can reach a local Laravel
         dev server (http://localhost:8000 via `adb reverse`, or a LAN IP).
         Release/profile builds do NOT include this, so production stays
         HTTPS-only. -->
    <application android:usesCleartextTraffic="true" />
</manifest>
