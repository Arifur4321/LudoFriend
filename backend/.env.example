# ---------------------------------------------------------------------------
# Ludo Friends — Application
# App identifier: com.arifurrahman.ludofriends
# Never commit real secrets. Copy to .env and fill in locally.
# ---------------------------------------------------------------------------
APP_NAME="Ludo Friends"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Database (MySQL)
# ---------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ludo_friends
DB_USERNAME=root
DB_PASSWORD=

# ---------------------------------------------------------------------------
# Session / Cache / Queue
# QUEUE_CONNECTION=database -> run `php artisan queue:work`
# ---------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# NOTE (scale): database drivers are fine for local dev but will not hold ~1,000
# concurrent players. In production switch the three below to redis (and set
# REDIS_CLIENT=phpredis with the ext-redis extension installed). See
# docs/PRODUCTION_PLAN_1K_TO_20K.md §4.
CACHE_STORE=database
CACHE_PREFIX=

QUEUE_CONNECTION=database

# Redis — production: CACHE_STORE=redis, QUEUE_CONNECTION=redis,
# SESSION_DRIVER=redis, and REVERB_SCALING_ENABLED=true for multi-node Reverb.
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# Sanctum (SPA / mobile token auth)
# Stateful domains for first-party SPA cookie auth; mobile uses bearer tokens.
# ---------------------------------------------------------------------------
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:8000
# Token lifetime in minutes. Set in production (e.g. 20160 = 14 days) and run
# `php artisan sanctum:prune-expired` on a schedule. Empty = never expires.
SANCTUM_TOKEN_EXPIRATION=20160

# CORS allowlist. Set an explicit comma-separated list in production. If left as
# "*", credentials are auto-disabled to stay CORS-spec compliant (mobile uses
# bearer tokens, so it keeps working).
CORS_ALLOWED_ORIGINS=*

# ---------------------------------------------------------------------------
# Broadcasting — Pusher protocol via Laravel Reverb (Soketi compatible)
# ---------------------------------------------------------------------------
BROADCAST_CONNECTION=reverb

REVERB_APP_ID=ludofriends
REVERB_APP_KEY=local-reverb-key
REVERB_APP_SECRET=local-reverb-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
# Multi-node Reverb (production): set true and point REDIS_* at a shared Redis.
REVERB_SCALING_ENABLED=false

# Client-facing values consumed by the mobile/web client (Pusher SDK)
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# ---------------------------------------------------------------------------
# Facebook Login / Friends-using-app (Graph API)
# ---------------------------------------------------------------------------
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_GRAPH_VERSION=v19.0
FACEBOOK_REDIRECT_URI=http://localhost/api/v1/auth/facebook/callback

# ---------------------------------------------------------------------------
# Mail (transactional — optional for guests)
# ---------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@ludofriends.app"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Ludo gameplay tuning (overrides config/ludo.php defaults)
# ---------------------------------------------------------------------------
LUDO_TURN_TIMER_SECONDS=20
LUDO_MAX_CONSECUTIVE_SIXES=3
LUDO_ROOM_STALE_MINUTES=15
LUDO_MATCHMAKING_BOT_FILL_SECONDS=30
LUDO_RECONNECT_GRACE_SECONDS=60

# ---------------------------------------------------------------------------
# Rate-limit knobs (requests per minute) consumed by RouteServiceProvider limiters
# ---------------------------------------------------------------------------
RATE_LIMIT_AUTH=6
RATE_LIMIT_GAME=30
RATE_LIMIT_API=60
